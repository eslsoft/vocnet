{
  "name": "vocnet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vocnet --local",
    "db:migrate:remote": "wrangler d1 migrations apply vocnet --remote",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --project unit --project web --coverage",
    "test:behavior": "node scripts/check-behavior-coverage.mjs",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm lint:arch && pnpm typecheck && pnpm test:behavior && pnpm test && pnpm test:coverage && pnpm build",
    "e2e": "node e2e/run.mjs",
    "lint": "biome check .",
    "lint:arch": "depcruise server/ shared/ src/ --config .dependency-cruiser.cjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cf-typegen": "wrangler types server/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "postinstall": "wrangler types server/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.18",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "i18next": "^26.3.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router": "^7.16.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.4.10",
    "@cloudflare/vite-plugin": "^1.39.2",
    "@cloudflare/vitest-pool-workers": "^0.16.15",
    "@cloudflare/workers-types": "^4.20260505.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.1.2",
    "msw": "^2.14.6",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.95.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "workerd"
    ]
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.30.2"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
