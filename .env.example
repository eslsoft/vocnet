# Server Configuration
SERVER_HOST=localhost
SERVER_GRPC_PORT=9090
SERVER_HTTP_PORT=8080

# Database Configuration
# For SQLite (default)
DATABASE_URL=file:./data/vocnet.db
# For PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/vocnet?sslmode=disable

DATABASE_LOG_SQL=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=

# JWT Authentication Configuration
# Supabase JWKS URL format: https://<project-ref>.supabase.co/auth/v1/jwks
# Replace <project-ref> with your actual Supabase project reference ID
AUTH_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/jwks

# Optional: JWT refresh period (default: 1h)
# AUTH_REFRESH_PERIOD=1h

# Pipeline Data Sources Configuration
# Base directory for all pipeline data sources (default: ./data)
# Data sources are stored under subdirectories: conceptnet/, ecdict/, wordnet/, moby/
PIPELINE_DATA_DIR=./data

# Auto-download missing data sources (default: true)
# Set to false to disable automatic download and require manual `pipeline source download`
PIPELINE_AUTO_DOWNLOAD=true

# Data cache directory (default: system cache dir)
# Downloaded files are cached here to avoid re-downloading
# PIPELINE_CACHE_DIR=~/.cache/vocnet

# LLM Configuration (Phase 4 - Intellectual Distillation)
# OpenAI-compatible endpoint (default: https://api.openai.com/v1)
# PIPELINE_LLM_BASE_URL=https://api.openai.com/v1
# API Key for LLM provider (required for Phase 4)
# PIPELINE_LLM_API_KEY=sk-xxx
# Model name (default: gpt-4o-mini)
# PIPELINE_LLM_MODEL=gpt-4o-mini
