# Server Configuration
SERVER_HOST=localhost
SERVER_GRPC_PORT=9090
SERVER_HTTP_PORT=8080

# Database Configuration
# For SQLite (default)
DATABASE_URL=file:./data/vocnet.db
# For PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/vocnet?sslmode=disable

DATABASE_LOG_SQL=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=

# Pipeline Configuration
# Base system data directory (default: ./data)
# Pipeline data sources are fixed under: ${PIPELINE_DATA_DIR}/datasources/
PIPELINE_DATA_DIR=./data

# Auto-download missing data sources (default: true)
# Set to false to disable automatic download and require manual `pipeline source download`
PIPELINE_AUTO_DOWNLOAD=true

# Data cache directory (default: system cache dir)
# Downloaded files are cached here to avoid re-downloading
# PIPELINE_CACHE_DIR=~/.cache/vocnet

# Number of concurrent pipeline workers (default: 10)
# PIPELINE_WORKER_COUNT=10

# Contrib sources (external data sources via JSON-RPC over stdio)
# Directory containing contrib source executables (default: empty, disabled)
PIPELINE_CONTRIB_DIR=./contrib/sources

# Comma-separated list of enabled contrib sources (default: empty)
# Available: ecdict, conceptnet, wordnet
PIPELINE_CONTRIB_LIST=ecdict,conceptnet,wordnet

# LLM Configuration (Optional - for intelligent gap filling after data collection)
# OpenAI-compatible endpoint (default: https://api.openai.com/v1)
# LLM_BASE_URL=https://api.openai.com/v1

# API Key for LLM provider (required to enable LLM enrichment phase)
# LLM_API_KEY=sk-xxx

# Model name (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
